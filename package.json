{
  "name": "gn-encuestas",
  "version": "1.0.0",
  "description": "PWA para visualización y exportación de encuestas de Google Forms",
  "main": "src/index.html",
  "scripts": {
    "build": "node scripts/gen-config.js",
    "prerender": "node scripts/prerender-publico.js",
    "predev": "node scripts/gen-config.js",
    "dev": "npx serve src -p 8080",
    "dev:open": "npx serve src -p 8080 --open",
    "test": "node --test tests/*.test.js",
    "scrape:milanuncios": "node scripts/scrape-milanuncios.mjs",
    "importar:animales": "node scripts/importar-animales.mjs",
    "reset:datos": "node scripts/reset-datos.mjs",
    "normalizar:galeria": "node scripts/normalizar-galeria.mjs",
    "borradores:web": "node scripts/crear-borradores.mjs",
    "smoke:contract": "node scripts/contract-smoke.mjs",
    "lint": "echo 'No hay linter configurado aún'"
  },
  "keywords": [
    "encuestas",
    "pwa",
    "google-forms",
    "pdf"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.65.1",
    "serve": "^14.2.0"
  }
}
