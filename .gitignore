# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Build
dist/
build/

# Configuración generada (contiene valores reales de producción)
src/js/config.js

# Prerender SEO del visor público (se genera en cada despliegue)
src/publicaciones/
src/sitemap.xml
src/robots.txt

# Backend Apps Script: solo se versionan las fuentes del gestor web (sin secretos).
# Config.gs y el resto (Auth, Roles, Backup...) contienen datos reales.
apps-script/*
!apps-script/Code.gs
!apps-script/WebPublicaciones.gs
# Reset operativo: lo llama el endpoint admin `reset-datos` y no lleva secretos.
!apps-script/ResetDatos.gs

# Temporary
*.tmp
*.temp

# Documentación interna / operativa (nunca se sube al repo público)
.internal-docs/
datos/milanuncios/
backups/

# Harness y artefactos de pruebas locales
e2e/
test-results/
