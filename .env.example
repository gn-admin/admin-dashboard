# ============================================================
# GN-Encuestas — Variables de entorno
#
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` NO se sube a git (ignorado). Los valores se inyectan
# en el build (GitHub Pages) vía Repository variables/secrets.
#
# FRONTEND (necesarios para GitHub Pages)
# Se añaden en GitHub: Settings -> Secrets and variables -> Actions
# como VARIABLE o SECRET para cada uno de estos nombres.
# ============================================================

# URL del backend desplegado en Google Apps Script (web app /exec)
API_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Configuración de Firebase Auth
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ============================================================
# BACKEND Apps Script (genera apps-script/Config.gs)
# Solo para uso local / despliegue manual del backend.
# NO hace falta añadirlas en GitHub.
# ============================================================

# Orígenes permitidos por CORS (lista JSON de strings, coincidencia exacta)
APPS_SCRIPT_ALLOWED_ORIGINS=["https://TUSUSUARIO.github.io","http://localhost:8080","http://localhost:3000"]

# Seguridad: exigir usuarios con email verificado en el backend (true por defecto)
APPS_SCRIPT_REQUIRE_EMAIL_VERIFIED=false
# Permitir peticiones sin cabecera Origin (false por defecto)
APPS_SCRIPT_ALLOW_ORIGIN_EMPTY=false
# Carpeta de Drive para las fotos de animales (ID entre los slashes de la URL de la carpeta)
APPS_SCRIPT_DRIVE_FOTOS_FOLDER_ID=

# Encuestas: IDs de formulario y de hoja de respuestas
FORM_PERROS_ID=
SHEET_PERROS_ID=
FORM_GATOS_ID=
SHEET_GATOS_ID=
FORM_ACOGIDA_ID=
SHEET_ACOGIDA_ID=

# Hojas de módulos del admin
SHEET_ANIMALES_ID=
SHEET_FAMILIAS_ID=
SHEET_ADOPCIONES_ID=
SHEET_SOCIOS_ID=
SHEET_BLACKLIST_ID=
SHEET_ACTIVIDAD_ID=
SHEET_ESTADOS_ID=
SHEET_NOTAS_ID=
SHEET_CANDIDATURAS_ID=
SHEET_ACOGIDAS_ID=
SHEET_CONTRATOS_ID=